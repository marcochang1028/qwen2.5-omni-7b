# =========================================
# 基本憑證 & 快取
# =========================================

# 必填：Hugging Face 讀取私有/受限模型的 Token
HUGGINGFACE_API_KEY=hf_xxx_your_token_here


# =========================================
# Logging
# =========================================

# 日誌層級：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日誌格式（通常不需改）
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 可選：transformers 安靜模式（error/warning/info/debug）
# TRANSFORMERS_VERBOSITY=error


# =========================================
# 模型設定（Qwen2.5 Omni ASR）
# =========================================

# 建議鎖定 revision（tag/commit），避免隨上游更新造成行為漂移
HF_REVISION=main

# 設備自動偵測：程式內會自動使用 GPU（有的話）
# 若要顯示控制精度/記憶體，請直接調整 Docker 映像/啟動參數（程式內已設 TF32/cudnn 最佳化）


# =========================================
# 服務/運行參數
# =========================================

# 閒置多久後釋放模型與 GPU（秒）
IDLE_TIMEOUT=300

# 最大併發推理數（以 Semaphore 控制）
MAX_CONCURRENT_INFERENCES=2

# 上傳音訊上限（MB）
MAX_UPLOAD_MB=1024

# 單次 API 轉錄整體超時（秒）
ASR_TIMEOUT=600


# =========================================
# 生成限制（避免暴衝）
# =========================================

# 單請求 allow 的上限（仍會再依片段秒數動態收斂）
ASR_MAX_NEW_TOKENS=512

# 以片段秒數估 token 上限（約略比照 phi4）
# 估算：max_new_tokens_per_segment = min(ASR_MAX_NEW_TOKENS, max(64, floor(duration_sec * ASR_TOKENS_PER_SECOND)))
ASR_TOKENS_PER_SECOND=12


# =========================================
# 音訊前處理
# =========================================

# 去頭尾靜音分貝門檻（0=不裁），數值越大裁得越多（librosa.effects.trim 的 top_db）
ASR_TRIM_DB=40

# 自動增益目標（dBFS；例如 -20 約等於 RMS 0.1），僅在音量過小時提升，不會壓大於 PEAK_LIMIT
ASR_GAIN_TARGET_DBFS=-20

# 峰值限制（避免 clipping），0.99 大多數情況即可
ASR_PEAK_LIMIT=0.98


# =========================================
# VAD（語音活動偵測）
# =========================================

# VAD 激進度（0~3；數值越大越容易切段）：程式會依 SNR/音量動態選 1/2/3，這裡是 fallback
ASR_VAD_AGGR=2

# 語音最短秒數（短於此長度不視為語音）
ASR_MIN_SPEECH_SEC=0.3

# 語音段內允許的最大靜音秒數（超過則切段）
ASR_MAX_SILENCE_SEC=0.5

# 每段左右延展（秒），讓邊界更自然
ASR_PAD_SEC=0.3

# 用於靜音快篩的音量門檻（dBFS），低於此值整段略過（避免把全靜音餵給模型）
ASR_SILENCE_DB_THRESHOLD=-55.0


# =========================================
# 切片策略（避免單段過長）
# =========================================

# 先以固定長度切片（秒），0 表示不做第一層固定切
ASR_CHUNK_SEC=30.0

# 每片段允許的最大秒數（超過則再二次切分）
ASR_MAX_SEG_SEC=45.0

# 片段重疊（秒），可幫助跨段語句融合
ASR_SEG_OVERLAP_SEC=1.0
